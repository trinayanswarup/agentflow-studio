# AgentFlow Studio — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── LLM ──────────────────────────────────────────────────
# Groq — free at groq.com
GROQ_API_KEY=

# Gemini — free at aistudio.google.com
GEMINI_API_KEY=

# ── Search ───────────────────────────────────────────────
# Tavily — free at tavily.com (1000 req/month)
TAVILY_API_KEY=

# ── Supabase ─────────────────────────────────────────────
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER SIDE ONLY, never use in client components
SUPABASE_SERVICE_ROLE_KEY=

# ── Observability ────────────────────────────────────────────────
# Langfuse — free at cloud.langfuse.com. Optional: if unset, tracing is a
# silent no-op and the app behaves exactly as without it.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ── Guardrails ───────────────────────────────────────────────────
# Max estimated USD cost per workflow run before the run is aborted with
# status BUDGET_EXCEEDED. Optional: defaults to 0.10 if unset.
WORKFLOW_COST_CAP_USD=0.10

# Max time (ms) a single node may run before it's failed with STEP_TIMEOUT.
# Does not apply to human_pause nodes, which have their own 5-minute wait.
# Optional: defaults to 30000 (30s) if unset.
WORKFLOW_STEP_TIMEOUT_MS=30000
