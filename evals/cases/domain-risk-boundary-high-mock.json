  "mocks": {
    "webSearchResults": [
      "1. borderline-domain.example\n   https://example.com\n   Some minor exposure reported."
    ],
    "llmResponses": [
      { "text": "{\"exposure\": \"minor\", \"known_breaches\": \"none found\", \"reputation_notes\": \"some concern\"}" },
      { "text": "{\"score\": 7, \"reasoning\": \"Borderline risk signals.\"}" }
    ]
  },
  "assertions": [
    { "type": "status", "expected": "completed" },
    { "type": "node_executed", "nodeId": "review_1" }
  ]
