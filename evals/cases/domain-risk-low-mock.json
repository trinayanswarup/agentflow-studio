{
  "id": "domain-risk-low-mock",
  "description": "Domain Risk Check skips analyst review for a low-risk domain (mocked judge score = 2)",
  "tags": ["mock", "domain-risk", "branching"],
  "template": "domain-risk",
  "input": "clean-domain.example",
  "mocks": {
    "webSearchResults": [
      "1. clean-domain.example\n   https://example.com\n   No known incidents. Clean reputation."
    ],
    "llmResponses": [
      { "text": "{\"exposure\": \"none found\", \"known_breaches\": \"none found\", \"reputation_notes\": \"clean\"}" },
      { "text": "{\"score\": 2, \"reasoning\": \"No breaches or exposure found.\"}" }
    ]
  },
  "assertions": [
    { "type": "status", "expected": "completed" },
    { "type": "node_not_executed", "nodeId": "review_1" },
    { "type": "node_executed", "nodeId": "output_1" },
    { "type": "contains", "value": "Risk score" }
  ]
}
